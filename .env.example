# PocketBase Configuration
# See https://pocketbase.io/docs for more info

# Port for PocketBase to listen on (default: 8080)
# Railway sets PORT automatically — override here if needed
PORT=8080

# Encryption key for encrypting app settings (32 hex characters recommended)
# Generate one: openssl rand -hex 16
ENCRYPTION_KEY=

# CORS allowed origins (comma-separated, if you need custom domains)
# ORIGINS=https://app.example.com,https://admin.example.com

# --- First-boot superuser seeding (runs ONCE on first deploy only) ---
# The deployment entrypoint only seeds when /pb_data/data.db is absent AND
# both ADMIN_USER and ADMIN_PASSWORD are set. After the first boot,
# subsequent deploys leave these as plain environment vars but never
# re-run `pocketbase superuser create`.
#
# Email of the first PocketBase superuser (PB CLI requires valid email).
ADMIN_USER=admin@example.com
# Password (>=5 chars). Leave blank to skip auto-seeding — the admin UI at
# /_/ will then offer a 'Create your first superuser' wizard.
ADMIN_PASSWORD=

